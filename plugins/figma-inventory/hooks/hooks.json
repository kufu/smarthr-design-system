{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(get_design_context|get_screenshot)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_figma.py\" claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(get_design_context|get_screenshot)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/extract_figma.py\" --hook claude",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
