---
import { basename, join } from 'node:path';

import { getSubPageCollection } from '@/lib/getSubPageCollection';

type Props = {
  basePath: string;
  heading: 'h2' | 'h3';
  excludePaths?: string[];
};

const { basePath, heading: Heading = 'h2', excludePaths = [] } = Astro.props;

// 自身のページを除いたサブページを取得
const rawSubPages = await getSubPageCollection(basePath, [...excludePaths, join(basePath, 'index.mdx')]);

// 先頭と末尾の/を削除
const normalizedBasePath = basePath.replace(/^\/|\/$/g, '');

// 1階層下のページのみを取得
const regex = new RegExp(`^${normalizedBasePath}/[^/]+$`);
const subPages = rawSubPages.filter((page) => regex.test(page.id));

// order昇順でソート
subPages.sort((a, b) => (a.data.order && b.data.order ? a.data.order - b.data.order : 1));
---

<div class="wrapper">
  <div class="pageList">
    {
      subPages.map(async (page) => {
        const pageFileName = basename(page.id);
        const hasSlot = Astro.slots.has(pageFileName);
        const description = hasSlot ? await Astro.slots.render(pageFileName) : page.data.description;

        return (
          <>
            {/* ページ内目次（IndexNav）のリンク先になるため、見出しには必ずidを振る */}
            <Heading class="pageTitleHeading" id={`${Heading}-${pageFileName}`}>
              {/* href は末尾スラッシュ付きの正規URLにする。join() は末尾スラッシュを落とすため使わない */}
              <a href={`/${page.id}/`}>{page.data.deprecated ? `${page.data.title}（非推奨）` : page.data.title}</a>
            </Heading>
            {hasSlot ? <Fragment set:html={description} /> : <p>{description}</p>}
          </>
        );
      })
    }
  </div>
</div>

<style lang="scss">
  .wrapper {
    margin-block: 4rem;
  }

  .pageList {
    padding: 0;
    list-style: none;

    > li {
      margin-bottom: 2rem;
    }
  }

  .pageTitleHeading {
    font-size: var(--font-size-20);
    font-weight: bold;

    a {
      text-decoration: underline;
    }
  }
</style>
