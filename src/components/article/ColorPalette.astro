---
import { hexToRgb } from '@/constants/colorTokens';

type Props = {
  colorName: string;
  colorValue: string;
  description?: string;
};

const { colorName, colorValue, description } = Astro.props;
const rgb = hexToRgb(colorValue);
---

<div class="wrapper">
  <div class="thumbnail" style={{ backgroundColor: colorValue }}></div>
  <div>
    <div class:list={['colorName', 'text']}>{colorName}</div>
    <div class="text">{colorValue}</div>
    {rgb && <div class="text">{rgb}</div>}
    <p class="text">{description}</p>
  </div>
</div>

<style lang="scss">
  .wrapper {
    width: calc(25% - 24px);
    height: auto;

    @include breakpointMobile3 {
      width: calc(50% - 24px);
    }
  }

  .thumbnail {
    width: 100%;
    height: 128px;
    margin-bottom: 12px;
    box-shadow: rgb(235, 236, 240) 0 0 0 1.2px;
  }

  .colorName {
    font-weight: bold;
  }

  .text {
    word-break: break-all;
  }
</style>
