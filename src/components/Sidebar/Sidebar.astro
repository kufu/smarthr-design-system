---
import Accordion from './Accordion';
import SidebarItems, { type Props as SidebarItemsProps } from './SidebarItems.astro';

type Props = {
  path: `/${string}`;
} & Pick<SidebarItemsProps, 'items'>;

const { path, items } = Astro.props;
---

{/* PC表示 */}
<div class="navWrapper" id="sidebar-nav-wrapper">
  <SidebarItems path={path} items={items} showDepth1Item />
</div>

{
  // SP表示
  items[0]?.children?.length > 0 && (
    <div class="spSidebar">
      <Accordion title={items[0].title} client:load>
        <SidebarItems path={path} items={items} />
      </Accordion>
    </div>
  )
}

<script>
  // サイドバーが長くスクロールする場合、ページ遷移直後は現在地の項目が表示領域外にあることがあるため、
  // サイドバー内のスクロール位置を調整して現在地を見えるようにする
  const wrapper = document.querySelector('#sidebar-nav-wrapper');
  // モバイル表示ではこの要素は display: none のため、スクロールの余地がなければ何もしない
  const isScrollable = wrapper !== null && wrapper.scrollHeight > wrapper.clientHeight;
  const currentItem = isScrollable ? wrapper.querySelector('a[aria-current="true"]') : null;

  if (wrapper && currentItem) {
    const wrapperRect = wrapper.getBoundingClientRect();
    const currentItemRect = currentItem.getBoundingClientRect();
    // サイドバーは position: sticky なため、ページのスクロール位置によってはヘッダーやウィンドウ外にはみ出す。
    // 実際に見えている範囲を基準にする
    const visibleTop = Math.max(wrapperRect.top, 0);
    const visibleBottom = Math.min(wrapperRect.bottom, window.innerHeight);
    const isVisible = currentItemRect.top >= visibleTop && currentItemRect.bottom <= visibleBottom;

    if (!isVisible) {
      // 現在地の前後の項目も見えるよう、表示領域の中央に寄せる。
      // ページ全体のスクロール位置に影響しないよう、scrollIntoView ではなくサイドバー自身のスクロール量を変更する
      wrapper.scrollTop += currentItemRect.top - visibleTop - (visibleBottom - visibleTop - currentItemRect.height) / 2;
    }
  }
</script>

<style lang="scss">
  .navWrapper {
    padding-block: 120px 48px;
    overflow-y: auto;

    @include breakpointMobile3 {
      display: none;
    }
  }

  .spSidebar {
    display: none;

    @include breakpointMobile3 {
      display: block;
      border-bottom: 1px solid var(--color-light-grey-1);
    }

    :global(button) {
      font-family: inherit;
      color: inherit;
      padding-inline: 24px;
    }

    :global(#spSidebar-content.entered) {
      /* アコーディオンが開いた時にsmarthr-uiが100vhを指定するが、100vh以上になりはみ出る場合があるので上書き */
      max-height: none;
    }
  }
</style>
